# --- Backend / Vercel environment ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated allowed origins (dev + deployed frontend)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,https://your-app.vercel.app

# Rate-limit / refresh-lock backend: "memory" (default, per-instance) or
# "supabase" (shared across serverless instances; requires the kv_store table
# and functions from sql/migration.sql)
SRR_STATE_BACKEND=memory

# Fallback defaults shown on the Settings screen (optional)
JIRA_CLOUD_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECTS=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Frontend (.env.local) ---
# Local dev: leave unset (defaults to http://127.0.0.1:5002).
# Separate Vercel deploy: set in the FRONTEND project to the backend project URL, e.g.
# VITE_API_BASE=https://srr-backend.vercel.app
